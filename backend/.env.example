# =============================================================================
# ClipForge configuration — copy to `.env` and edit.
# Nothing here is hardcoded in the code; every value has a safe default.
# =============================================================================

# ------------------------------------------------------------------------ app
APP_NAME=ClipForge
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api
# Comma-separated list of allowed CORS origins (the vite dev server in dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------- security
# CHANGE THIS. Any random string, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Per-user daily pipeline quota
MAX_JOBS_PER_DAY=20

# -------------------------------------------------------------------- storage
STORAGE_DIR=./data/storage
MODELS_DIR=./data/models
MAX_UPLOAD_GB=4.0
CLEANUP_AFTER_DAYS=7

# ----------------------------------------------------------------- database
# PostgreSQL in docker; sqlite fallback keeps local dev zero-config
DATABASE_URL=sqlite:///./data/clipforge.db

# --------------------------------------------------------------------- tasks
# thread = in-process worker (zero infra); celery = Redis + worker container
TASK_BACKEND=thread
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=2

# -------------------------------------------------------------------- ingest
YT_DLP_FORMAT=bv*[height<=1080]+ba/b[height<=1080]/b

# ------------------------------------------------------------------ whisper
# large-v3 for best quality; tiny/base for smoke tests on CPU
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=5
TRANSCRIBE_CACHE=true

# ----------------------------------------------------------------- pyannote
# Required for speaker diarization: https://huggingface.co/settings/tokens
# and accept the pyannote/speaker-diarization-3.1 model conditions.
HF_TOKEN=
DIARIZATION_ENABLED=true

# ----------------------------------------------------------------------- LLM
# anthropic = Claude for moment detection; none = keyword-only fallback scoring
# Any Anthropic Messages-compatible endpoint works: set LLM_BASE_URL to its
# base URL and ANTHROPIC_API_KEY to the key that provider issued.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-sonnet-4-5
LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=120
LLM_CHUNK_SECONDS=600

# ------------------------------------------------------------------ scoring
# Viral score is a weighted ensemble of per-signal scores (each 0..1).
# Weights must sum to ~1.0; unknown keys are ignored.
SCORE_WEIGHTS=llm_overall:0.30,hook:0.20,emotion:0.15,audio_energy:0.10,laughter:0.10,completeness:0.10,visual:0.05
DEFAULT_TOP_N_CLIPS=10
MIN_CLIP_SCORE=35.0

# ------------------------------------------------------------------- render
TARGET_LUFS=-14.0
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
PREFERRED_FPS=60
H264_CRF=18
H265_CRF=22
# libx264/libx265 preset. medium is the x264 default; veryfast/faster gives a
# large speedup on low-core CPUs at a small bitrate cost.
H264_PRESET=medium
H265_PRESET=medium
VIDEO_BITRATE_MAX=16M
VIDEO_BITRATE_BUF=24M
# auto = NVENC when a usable NVIDIA encoder is present, else libx264/libx265
VIDEO_CODEC=auto
NVENC_CQ=20
# Concurrent NVENC encodes; consumer GPUs run out of encoder slots fast
NVENC_MAX_PARALLEL=2
# Leave empty to skip the watermark overlay
WATERMARK_TEXT=
HOOK_TITLE_SECONDS=3.5
CENSOR_PROFANITY=false
AUTO_EMOJI=true
# True motion interpolation (minterpolate) is slow; false = frame duplication
FRAME_INTERPOLATION=false
